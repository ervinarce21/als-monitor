#!/usr/bin/env bash

set -euo pipefail

# Resolve the source location when invoked through /usr/local/bin.
SCRIPT_PATH="$(readlink -f -- "$0")"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
cd "$PROJECT_ROOT"

show_help() {
    cat <<'EOF'
Usage: als-monitor SERVICE [OPTIONS]

Services:
  ui        Run the NEXA user interface
  eye       Run the eye-tracking test
  preview   Run the eye-camera preview
  grip      Run the load-cell grip monitor
  shoulder  Run the shoulder-angle monitor
  speech    Run speech-analysis commands
  help      Show this help

Run without a service to open the interactive menu.
EOF
}

choose_service() {
    echo "ALS Monitor"
    echo "1) NEXA UI"
    echo "2) Eye tracker"
    echo "3) Eye-camera preview"
    echo "4) Grip monitor"
    echo "5) Shoulder monitor"
    echo "6) Speech analysis"
    echo "7) Exit"
    read -r -p "Select a service [1-7]: " choice

    case "$choice" in
        1) selected_service="ui" ;;
        2) selected_service="eye" ;;
        3) selected_service="preview" ;;
        4) selected_service="grip" ;;
        5) selected_service="shoulder" ;;
        6) selected_service="speech" ;;
        7) exit 0 ;;
        *) echo "Invalid selection." >&2; exit 2 ;;
    esac
}

service="${1:-}"
if [[ -n "$service" ]]; then
    shift
else
    selected_service=""
    choose_service
    service="$selected_service"
fi

case "$service" in
    ui|nexa|nexa-ui)
        exec python3 "$PROJECT_ROOT/nexa_ui/app.py" "$@"
        ;;
    eye|eye-tracker)
        exec python3 -m als_monitor.eye_tracker "$@"
        ;;
    preview|eye-preview)
        exec python3 -m als_monitor.eye_tracker.preview "$@"
        ;;
    grip|grip-monitor)
        exec python3 -m als_monitor.grip_monitor "$@"
        ;;
    shoulder|shoulder-monitor)
        exec python3 -m als_monitor.shoulder_monitor "$@"
        ;;
    speech|speech-analysis)
        echo "Starting NEXA speech analysis..."
        if [[ $# -eq 0 ]]; then
            exec python3 -m als_monitor.speech_analysis menu
        fi
        exec python3 -m als_monitor.speech_analysis "$@"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown service: $service" >&2
        show_help >&2
        exit 2
        ;;
esac
