#!/usr/bin/env bash

set -euo pipefail

# Resolve the source location when invoked through /usr/local/bin.
SCRIPT_PATH="$(readlink -f -- "$0")"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
cd "$PROJECT_ROOT"

# Desktop shortcuts do not inherit an activated terminal environment.
PYTHON_BIN="python3"
if [[ -x "$PROJECT_ROOT/.venv/bin/python" ]]; then
    PYTHON_BIN="$PROJECT_ROOT/.venv/bin/python"
fi

show_help() {
    cat <<'EOF'
Usage: nexa [SERVICE] [OPTIONS]

Services:
  ui        Run the NEXA user interface
  eye       Run the eye-tracking test
  preview   Run the eye-camera preview
  grip      Run the load-cell grip monitor
  shoulder  Run the shoulder-angle monitor
  speech    Run speech-analysis commands
  help      Show this help

Run without a service to open the NEXA user interface.
EOF
}

service="${1:-ui}"
if [[ -n "$service" ]]; then
    [[ $# -eq 0 ]] || shift
fi

case "$service" in
    ui|nexa|nexa-ui)
        exec "$PYTHON_BIN" "$PROJECT_ROOT/nexa_ui/app.py" "$@"
        ;;
    eye|eye-tracker)
        exec "$PYTHON_BIN" -m als_monitor.eye_tracker "$@"
        ;;
    preview|eye-preview)
        exec "$PYTHON_BIN" -m als_monitor.eye_tracker.preview "$@"
        ;;
    grip|grip-monitor)
        exec "$PYTHON_BIN" -m als_monitor.grip_monitor "$@"
        ;;
    shoulder|shoulder-monitor)
        if [[ -x "$PROJECT_ROOT/.venv-shoulder/bin/python" ]]; then
            PYTHON_BIN="$PROJECT_ROOT/.venv-shoulder/bin/python"
        fi
        exec "$PYTHON_BIN" -u -X faulthandler -m als_monitor.shoulder_monitor "$@"
        ;;
    speech|speech-analysis)
        echo "Starting NEXA speech analysis..."
        if [[ $# -eq 0 ]]; then
            exec "$PYTHON_BIN" -m als_monitor.speech_analysis menu
        fi
        exec "$PYTHON_BIN" -m als_monitor.speech_analysis "$@"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown service: $service" >&2
        show_help >&2
        exit 2
        ;;
esac
